[submodule "glfw"]
	path = libs/glfw
	url = https://github.com/glfw/glfw.git
[submodule "glm"]
	path = libs/glm
	url = https://github.com/g-truc/glm.git
[submodule "stb"]
	path = libs/stb
	url = https://github.com/nothings/stb.git
[submodule "assimp"]
	path = libs/assimp
